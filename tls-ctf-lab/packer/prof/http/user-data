#cloud-config
users:
  - name: ansible
    sudo: ALL=(ALL) NOPASSWD:ALL
    plain_text_passwd: 'ansible'
    lock_passwd: false
    shell: /bin/bash

ssh_pwauth: true

chpasswd:
  list: |
    ansible:ansible
  expire: false

runcmd:
  - ssh-keygen -A
  - systemctl enable ssh
  - systemctl restart ssh